#!/usr/bin/env bash
set -uo pipefail

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/hyprtrixie/current"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
HERE="$(dirname "$(readlink -f "$0")")"

usage() {
  cat <<'EOF'
Usage: hyprtrixie-background <file>
       hyprtrixie-background next
       hyprtrixie-background --list
       hyprtrixie-background --current
       hyprtrixie-background workspaces

Sets the wallpaper. Backgrounds come from the current theme and from
~/.config/hyprtrixie/backgrounds/<theme>. With a wallpaper per workspace on
(hyprtrixie-look workspaces on), each workspace shows the next one along,
and workspaces shows each monitor's.
EOF
}

backgrounds() {
  local name dir dirs=()
  name="$(cat "$STATE/theme.name" 2>/dev/null)"
  for dir in "$STATE/theme/backgrounds" "$CONFIG_HOME/hyprtrixie/backgrounds/$name"; do
    [[ -d $dir ]] && dirs+=("$dir")
  done
  ((${#dirs[@]})) || return 0
  find "${dirs[@]}" -maxdepth 1 -type f \
    \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) | sort
}

next() {
  local current found=() index
  current="$(readlink "$STATE/background" 2>/dev/null)"
  mapfile -t found < <(backgrounds)
  ((${#found[@]})) || return 1
  for index in "${!found[@]}"; do
    if [[ ${found[index]} == "$current" ]]; then
      printf '%s\n' "${found[(index + 1) % ${#found[@]}]}"
      return 0
    fi
  done
  printf '%s\n' "${found[0]}"
}

per_workspace() {
  local command=hyprtrixie-look
  [[ -x $HERE/$command ]] && command="$HERE/$command"
  [[ "$("$command" get workspaces 2>/dev/null)" == yes ]]
}

workspaces() {
  local found=() current offset=0 index monitor id
  [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] || return 1
  mapfile -t found < <(backgrounds)
  ((${#found[@]})) || return 0
  current="$(readlink "$STATE/background" 2>/dev/null)"
  for index in "${!found[@]}"; do
    [[ ${found[index]} == "$current" ]] && offset="$index"
  done
  while IFS=$'\t' read -r monitor id; do
    [[ $id =~ ^-?[0-9]+$ ]] || continue
    ((id > 0)) || id=1
    hyprctl hyprpaper wallpaper "$monitor,${found[(id - 1 + offset) % ${#found[@]}]},cover" >/dev/null 2>&1 || return 1
  done < <(hyprctl monitors -j 2>/dev/null | jq -r '.[] | [.name, .activeWorkspace.id] | @tsv' 2>/dev/null)
}

over_ipc() {
  local file="$1" monitor monitors=()
  [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] || return 1
  mapfile -t monitors < <(hyprctl monitors -j 2>/dev/null | jq -r '.[].name' 2>/dev/null)
  ((${#monitors[@]})) || return 1
  for monitor in "${monitors[@]}"; do
    hyprctl hyprpaper wallpaper "$monitor,$file,cover" >/dev/null 2>&1 || return 1
  done
}

apply() {
  local file="$1"
  if [[ ! -f $file ]]; then
    printf 'no such background: %s\n' "$file" >&2
    return 1
  fi
  mkdir -p "$STATE" && ln -nsf "$file" "$STATE/background" || return 1
  if per_workspace; then
    workspaces && return 0
  else
    over_ipc "$file" && return 0
  fi
  if pkill -x hyprpaper; then
    timeout 3 pidwait -x hyprpaper
    setsid -f hyprtrixie-start hyprpaper >/dev/null 2>&1
  fi
  return 0
}

case "${1:-}" in
  "")
    usage >&2
    exit 2
    ;;
  -h | --help)
    usage
    ;;
  --list)
    backgrounds
    ;;
  --current)
    readlink "$STATE/background"
    ;;
  workspaces)
    per_workspace || exit 0
    workspaces
    ;;
  next)
    file="$(next)" || {
      printf 'the current theme has no backgrounds\n' >&2
      exit 1
    }
    apply "$file"
    ;;
  *)
    apply "$(realpath -- "$1")"
    ;;
esac
