#!/usr/bin/env bash
set -uo pipefail

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

usage() {
  cat <<'EOF'
Usage: hyprtrixie-background <file>
       hyprtrixie-background next
       hyprtrixie-background --list
       hyprtrixie-background --current

Sets the wallpaper. Backgrounds come from the current theme and from
~/.config/omarchy/backgrounds/<theme>.
EOF
}

backgrounds() {
  local name dir dirs=()
  name="$(cat "$STATE/theme.name" 2>/dev/null)"
  for dir in "$STATE/theme/backgrounds" "$CONFIG_HOME/omarchy/backgrounds/$name"; do
    [[ -d $dir ]] && dirs+=("$dir")
  done
  ((${#dirs[@]})) || return 0
  find "${dirs[@]}" -maxdepth 1 -type f \
    \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) | sort
}

next() {
  local current found=() index
  current="$(readlink "$STATE/background" 2>/dev/null)"
  mapfile -t found < <(backgrounds)
  ((${#found[@]})) || return 1
  for index in "${!found[@]}"; do
    if [[ ${found[index]} == "$current" ]]; then
      printf '%s\n' "${found[(index + 1) % ${#found[@]}]}"
      return 0
    fi
  done
  printf '%s\n' "${found[0]}"
}

apply() {
  local file="$1"
  if [[ ! -f $file ]]; then
    printf 'no such background: %s\n' "$file" >&2
    return 1
  fi
  mkdir -p "$STATE" && ln -nsf "$file" "$STATE/background" || return 1
  if pkill -x hyprpaper; then
    timeout 3 pidwait -x hyprpaper
    setsid -f hyprpaper >/dev/null 2>&1
  fi
  return 0
}

case "${1:-}" in
  "")
    usage >&2
    exit 2
    ;;
  -h | --help)
    usage
    ;;
  --list)
    backgrounds
    ;;
  --current)
    readlink "$STATE/background"
    ;;
  next)
    file="$(next)" || {
      printf 'the current theme has no backgrounds\n' >&2
      exit 1
    }
    apply "$file"
    ;;
  *)
    apply "$(realpath -- "$1")"
    ;;
esac
