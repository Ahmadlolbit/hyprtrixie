#!/usr/bin/env bash
set -uo pipefail

OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current"
USER_THEMES="$CONFIG_HOME/omarchy/themes"
USER_TEMPLATES="$CONFIG_HOME/omarchy/themed"
DENIED=" alacritty.toml foot.ini ghostty.conf kitty.conf vscode.json "
HERE="$(dirname "$(readlink -f "$0")")"
declare -A COLORS=()

usage() {
  cat <<'EOF'
Usage: omarchy-theme-set <theme>
       omarchy-theme-set --list
       omarchy-theme-set --previews
       omarchy-theme-set --current

Applies a theme to Hyprland, the bar, kitty, the launcher, notifications, the
lock screen, btop, GTK and the wallpaper. Themes come from
/usr/share/omarchy/themes and ~/.config/omarchy/themes.
EOF
}

pretty() {
  sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g'
}

theme_names() {
  local dir dirs=()
  for dir in "$OMARCHY_PATH/themes" "$USER_THEMES"; do
    [[ -d $dir ]] && dirs+=("$dir")
  done
  ((${#dirs[@]})) || return 0
  find "${dirs[@]}" -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n' | sort -u
}

preview_of() {
  local dir file found=()
  for dir in "$USER_THEMES/$1" "$OMARCHY_PATH/themes/$1"; do
    for file in "$dir"/preview.{png,jpg,jpeg,webp}; do
      if [[ -f $file ]]; then
        printf '%s\n' "$file"
        return 0
      fi
    done
  done
  for dir in "$USER_THEMES/$1/backgrounds" "$OMARCHY_PATH/themes/$1/backgrounds"; do
    [[ -d $dir ]] || continue
    mapfile -t found < <(find "$dir" -maxdepth 1 -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) | sort)
    if ((${#found[@]})); then
      printf '%s\n' "${found[0]}"
      return 0
    fi
  done
  printf '\n'
}

slug() {
  sed -E 's/<[^>]+>//g' <<<"$1" | tr '[:upper:]' '[:lower:]' | tr ' ' '-'
}

stage() {
  local name="$1" next="$2" entry base
  rm -rf "$next"
  mkdir -p "$next" || return 1
  if [[ -d $OMARCHY_PATH/themes/$name ]]; then
    cp -r "$OMARCHY_PATH/themes/$name/." "$next/" || return 1
  fi
  [[ -d $USER_THEMES/$name ]] || return 0
  if [[ -L $USER_THEMES/$name || ! -d $USER_THEMES/$name/.git ]]; then
    cp -r "$USER_THEMES/$name/." "$next/"
    return
  fi
  for entry in "$USER_THEMES/$name"/*; do
    base="${entry##*/}"
    if [[ -L $entry || $base == *.lua || $DENIED == *" $base "* ]]; then
      printf 'ignored %s from %s: a theme from a git repo cannot ship code or terminal configs\n' "$base" "$USER_THEMES/$name" >&2
      continue
    fi
    cp -r --no-dereference "$entry" "$next/" || return 1
  done
}

read_colors() {
  local line key value
  while IFS= read -r line; do
    if [[ $line =~ ^[[:space:]]*([a-z0-9_]+)[[:space:]]*=[[:space:]]*\"([^\"]*)\" ]] ||
      [[ $line =~ ^[[:space:]]*([a-z0-9_]+)[[:space:]]*=[[:space:]]*([^[:space:]#\"]+) ]]; then
      key="${BASH_REMATCH[1]}"
      value="${BASH_REMATCH[2]}"
      [[ $value =~ ^[A-Za-z0-9#(),.%_\ -]*$ ]] && COLORS[$key]="$value"
    fi
  done <"$1"
}

fallback() {
  [[ -n ${COLORS[$1]:-} ]] && return 0
  if [[ -n $2 && -n ${COLORS[$2]:-} ]]; then
    COLORS[$1]="${COLORS[$2]}"
  else
    COLORS[$1]="${3:-}"
  fi
}

mix() {
  local a="${1#\#}" b="${2#\#}" amount="$3" i out="#"
  [[ $a =~ ^[0-9A-Fa-f]{6}$ && $b =~ ^[0-9A-Fa-f]{6}$ ]] || {
    printf '%s' "$1"
    return
  }
  for i in 0 2 4; do
    printf -v out '%s%02x' "$out" $(((16#${a:i:2} * (100 - amount) + 16#${b:i:2} * amount + 50) / 100))
  done
  printf '%s' "$out"
}

resolve_colors() {
  local pair key
  for pair in background:bg foreground:fg dark_background:dark_bg darker_background:darker_bg lighter_background:lighter_bg \
    dark_foreground:dark_fg light_foreground:light_fg bright_foreground:bright_fg background:color0 foreground:color7 \
    red:color1 green:color2 yellow:color3 blue:color4 magenta:color5 cyan:color6 bright_red:color9 bright_green:color10 \
    bright_yellow:color11 bright_blue:color12 bright_magenta:color13 bright_cyan:color14 magenta:purple mode:theme_type; do
    fallback "${pair%%:*}" "${pair#*:}"
  done
  fallback background "" "#1e1e2e"
  fallback foreground "" "#cdd6f4"
  for key in red green yellow blue magenta cyan; do
    fallback "$key" foreground
  done
  fallback bright_foreground color15 "${COLORS[foreground]}"
  fallback light_foreground foreground
  fallback lighter_background background
  fallback dark_foreground color8 "${COLORS[foreground]}"
  fallback muted color8 "${COLORS[dark_foreground]}"
  fallback selection selection_background "${COLORS[muted]}"
  fallback selection_background selection
  fallback selection_foreground bright_foreground
  fallback accent blue
  fallback orange yellow
  fallback brown "" "$(mix "${COLORS[orange]}" "#000000" 50)"
  fallback dark_background "" "$(mix "${COLORS[background]}" "#000000" 25)"
  fallback darker_background "" "$(mix "${COLORS[background]}" "#000000" 50)"
  for key in red green yellow blue magenta cyan; do
    fallback "bright_$key" "" "$(mix "${COLORS[$key]}" "#ffffff" 20)"
  done
  [[ ${COLORS[mode]:-} == light ]] || COLORS[mode]=dark
}

look() {
  local command=hyprtrixie-look value
  [[ -x $HERE/$command ]] && command="$HERE/$command"
  value="$("$command" get "$1" 2>/dev/null)"
  printf '%s\n' "${value:-$2}"
}

accent_override() {
  local accent original="${COLORS[accent]}"
  accent="$(look accent theme)"
  if [[ $accent =~ ^#[0-9A-Fa-f]{6}$ ]]; then
    COLORS[accent]="$accent"
  elif [[ $accent != theme && ${COLORS[$accent]:-} =~ ^#[0-9A-Fa-f]{6}$ ]]; then
    COLORS[accent]="${COLORS[$accent]}"
  else
    return 0
  fi
  if grep -q '^accent *=' "$1"; then
    sed -i "s|^accent *=.*|accent = \"${COLORS[accent]}\"|" "$1"
  else
    printf 'accent = "%s"\n' "${COLORS[accent]}" >>"$1"
  fi
  printf 'theme_accent = "%s"\n' "$original" >>"$1"
}

glass_settings() {
  if [[ "$(look glass no)" == yes ]]; then
    COLORS[glass]=yes
    COLORS[opacity]=0.88
    COLORS[panel_alpha]=cc
  else
    COLORS[glass]=no
    COLORS[opacity]=1.0
    COLORS[panel_alpha]=ee
  fi
}

remember_pick() {
  local command=hyprtrixie-look
  [[ -z ${HYPRTRIXIE_LOOK_AUTO:-} ]] || return 0
  [[ "$(look auto off)" != off ]] || return 0
  [[ -x $HERE/$command ]] && command="$HERE/$command"
  "$command" remember "$1" "${COLORS[mode]}"
}

render() {
  local dir="$1" script key value tpl name
  script="$(mktemp)" || return 1
  for key in "${!COLORS[@]}"; do
    value="${COLORS[$key]}"
    printf 's|{{ %s }}|%s|g\ns|{{ %s_strip }}|%s|g\n' "$key" "$value" "$key" "${value#\#}" >>"$script"
    if [[ $value =~ ^#([0-9A-Fa-f]{2})([0-9A-Fa-f]{2})([0-9A-Fa-f]{2})$ ]]; then
      printf 's|{{ %s_rgb }}|%d,%d,%d|g\n' "$key" "$((16#${BASH_REMATCH[1]}))" "$((16#${BASH_REMATCH[2]}))" "$((16#${BASH_REMATCH[3]}))" >>"$script"
    fi
  done
  for tpl in "$USER_TEMPLATES"/*.tpl "$OMARCHY_PATH/default/themed"/*.tpl; do
    [[ -f $tpl ]] || continue
    name="$(basename "$tpl" .tpl)"
    [[ -e $dir/$name ]] || sed -f "$script" "$tpl" >"$dir/$name"
  done
  rm -f "$script"
}

pick_background() {
  local name="$1" previous="$2" found=()
  [[ $previous == "$name" && -e $STATE/background ]] && return 0
  mapfile -t found < <(find "$STATE/theme/backgrounds" "$CONFIG_HOME/omarchy/backgrounds/$name" -maxdepth 1 -type f \
    \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) 2>/dev/null | sort)
  ((${#found[@]})) || return 0
  ln -nsf "${found[0]}" "$STATE/background"
}

link_apps() {
  local theme="$STATE/theme"
  if [[ -f $theme/walker.css ]]; then
    mkdir -p "$CONFIG_HOME/walker/themes/hyprtrixie" &&
      ln -nsf "$theme/walker.css" "$CONFIG_HOME/walker/themes/hyprtrixie/style.css"
  fi
  if [[ -f $theme/btop.theme ]]; then
    mkdir -p "$CONFIG_HOME/btop/themes" && ln -nsf "$theme/btop.theme" "$CONFIG_HOME/btop/themes/hyprtrixie.theme"
  fi
}

interface() {
  if [[ -n ${DBUS_SESSION_BUS_ADDRESS:-} ]]; then
    gsettings "$1" org.gnome.desktop.interface "${@:2}"
  else
    dbus-run-session -- gsettings "$1" org.gnome.desktop.interface "${@:2}" 2>/dev/null
  fi
}

desktop_settings() {
  local mode="${COLORS[mode]}" icons="" ui
  command -v gsettings >/dev/null || return 0
  interface set color-scheme "prefer-$mode"
  if [[ $mode == light ]]; then
    interface set gtk-theme Adwaita
  else
    interface set gtk-theme Adwaita-dark
  fi
  interface set monospace-font-name "${COLORS[font]} 11"
  ui="$(look ui_font default)"
  if [[ $ui == default ]]; then
    interface reset font-name
  else
    interface set font-name "$ui 11"
  fi
  [[ -f $STATE/theme/icons.theme ]] && icons="$(head -n 1 "$STATE/theme/icons.theme")"
  if [[ ! $icons =~ ^[A-Za-z0-9._-]+$ || ! -d /usr/share/icons/$icons ]]; then
    icons=Yaru
    [[ $mode == dark ]] && icons=Yaru-dark
  fi
  interface set icon-theme "$icons"
  interface set cursor-theme Bibata-Modern-Ice
}

retint() {
  [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] || return 0
  hyprctl reload >/dev/null 2>&1
  if pkill -x hyprpaper; then
    timeout 3 pidwait -x hyprpaper
    setsid -f hyprtrixie-start hyprpaper >/dev/null 2>&1
    setsid -f sh -c 'sleep 1; exec hyprtrixie-background workspaces' >/dev/null 2>&1
  fi
  makoctl reload >/dev/null 2>&1
  qs -p /usr/share/hyprtrixie/shell ipc call theme reload >/dev/null 2>&1
  pkill -USR1 -x kitty
  pkill -USR2 -x btop
  if pkill -x walker; then
    setsid -f hyprtrixie-start walker >/dev/null 2>&1
  fi
  return 0
}

apply() {
  local name="$1" next="$STATE/next-theme" previous
  previous="$(cat "$STATE/theme.name" 2>/dev/null)"
  stage "$name" "$next" || return 1
  if [[ ! -f $next/colors.toml ]]; then
    printf 'theme %s has no colors.toml\n' "$name" >&2
    rm -rf "$next"
    return 1
  fi
  read_colors "$next/colors.toml"
  if [[ -z ${COLORS[mode]:-}${COLORS[theme_type]:-} && -f $next/light.mode ]]; then
    COLORS[mode]=light
  fi
  resolve_colors
  accent_override "$next/colors.toml"
  COLORS[font]="$(look font 'JetBrainsMono Nerd Font')"
  [[ ${COLORS[font]} =~ ^[[:alnum:]][[:alnum:]\ ._+-]*$ ]] || COLORS[font]="JetBrainsMono Nerd Font"
  glass_settings
  render "$next" || return 1
  [[ ${COLORS[glass]} == yes ]] || rm -f "$next/glass.lua"
  rm -rf "$STATE/theme"
  mv "$next" "$STATE/theme" || return 1
  printf '%s\n' "$name" >"$STATE/theme.name"
  pick_background "$name" "$previous"
  link_apps
  desktop_settings
  remember_pick "$name"
  return 0
}

case "${1:-}" in
  "")
    usage >&2
    exit 2
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  --list)
    theme_names | pretty
    exit
    ;;
  --previews)
    while IFS= read -r name; do
      printf '%s\t%s\t%s\n' "$name" "$(pretty <<<"$name")" "$(preview_of "$name")"
    done < <(theme_names)
    exit 0
    ;;
  --current)
    [[ -f $STATE/theme.name ]] || exit 1
    pretty <"$STATE/theme.name"
    exit
    ;;
esac

name="$(slug "$1")"
if [[ -z $name || $name == .* || $name == */* ]] || [[ ! -d $OMARCHY_PATH/themes/$name && ! -d $USER_THEMES/$name ]]; then
  printf 'no theme named %s; see omarchy-theme-set --list\n' "$1" >&2
  exit 1
fi

mkdir -p "$STATE" || exit 1
exec 9>"$STATE/.lock"
flock 9
apply "$name" || exit 1
exec 9>&-
retint
