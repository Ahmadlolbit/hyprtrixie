#!/usr/bin/env bash
set -uo pipefail

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
USER_LOOK="$CONFIG_HOME/hyprtrixie/look.conf"
SYSTEM_LOOK="${HYPRTRIXIE_LOOK_SYSTEM:-/etc/hyprtrixie/look.conf}"
CURRENT="$STATE_HOME/omarchy/current"
HERE="$(dirname "$(readlink -f "$0")")"
KEYS=(accent)
declare -A DEFAULT=([accent]=theme)
ACCENTS=" theme red orange yellow green cyan blue magenta "

usage() {
  cat <<'USAGE'
Usage: hyprtrixie-look
       hyprtrixie-look accent [theme|red|orange|yellow|green|cyan|blue|magenta|#rrggbb]
       hyprtrixie-look get SETTING

Shows and changes how the desktop looks. Your settings are kept in
~/.config/hyprtrixie/look.conf and win over the setup menu's in
/etc/hyprtrixie/look.conf. With no value, a command prints the setting.
An accent named after a colour uses that colour of each theme.
USAGE
}

read_setting() {
  sed -n "s/^$2=//p" "$1" 2>/dev/null | tail -n 1
}

get() {
  local file value
  for file in "$USER_LOOK" "$SYSTEM_LOOK"; do
    value="$(read_setting "$file" "$1")"
    if [[ -n $value ]]; then
      printf '%s\n' "$value"
      return 0
    fi
  done
  printf '%s\n' "${DEFAULT[$1]}"
}

put() {
  local tmp
  mkdir -p "${USER_LOOK%/*}" || return 1
  tmp="$(mktemp "$USER_LOOK.XXXXXX")" || return 1
  grep -v "^$1=" "$USER_LOOK" >"$tmp" 2>/dev/null
  printf '%s=%s\n' "$1" "$2" >>"$tmp"
  mv "$tmp" "$USER_LOOK"
}

command_path() {
  if [[ -x $HERE/$1 ]]; then
    printf '%s\n' "$HERE/$1"
  else
    printf '%s\n' "$1"
  fi
}

reapply() {
  local name
  name="$(cat "$CURRENT/theme.name" 2>/dev/null)"
  [[ -n $name ]] || return 0
  "$(command_path omarchy-theme-set)" "$name"
}

accent() {
  local value="${1,,}"
  if [[ -z $value ]]; then
    get accent
    return 0
  fi
  if [[ $ACCENTS != *" $value "* && ! $value =~ ^#[0-9a-f]{6}$ ]]; then
    printf 'not an accent: %s (theme, a colour name or #rrggbb)\n' "$1" >&2
    return 2
  fi
  put accent "$value" && reapply
}

case "${1:-}" in
  "")
    for key in "${KEYS[@]}"; do
      printf '%s=%s\n' "$key" "$(get "$key")"
    done
    ;;
  get)
    if [[ -z ${DEFAULT[${2:-}]+set} ]]; then
      usage >&2
      exit 2
    fi
    get "$2"
    ;;
  accent) accent "${2:-}" ;;
  -h | --help) usage ;;
  *)
    usage >&2
    exit 2
    ;;
esac
