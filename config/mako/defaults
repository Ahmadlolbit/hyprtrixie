font=JetBrainsMono Nerd Font 11
width=380
height=160
margin=12
padding=12,16
border-size=2
border-radius=0
icons=1
max-icon-size=48
background-color=#1e1e2eee
text-color=#cdd6f4
border-color=#89b4fa
progress-color=over #313244
default-timeout=5000
max-visible=5
layer=overlay
anchor=top-right

[urgency=low]
border-color=#45475a

[urgency=critical]
border-color=#f38ba8
default-timeout=0

[mode=do-not-disturb]
invisible=1

[mode=focus]
invisible=1

[app-name=hyprtrixie-firmware]
on-button-left=exec makoctl dismiss -n "$id"; hyprtrixie-terminal --wait sh -c 'fwupdmgr refresh --force; fwupdmgr update'

[app-name=hyprtrixie-disk]
on-button-left=exec makoctl dismiss -n "$id"; hyprtrixie-terminal --wait sudo hyprtrixie cleanup
