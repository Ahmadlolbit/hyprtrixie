#!/usr/bin/env bash
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
root="$(dirname "$here")"
version="${1:-}"
user="${SOURCEFORGE_USER:-}"
project="${SOURCEFORGE_PROJECT:-hyprtrixie}"
key="${HYPRTRIXIE_RELEASE_KEY:-$HOME/.ssh/hyprtrixie-release}"
built="${2:-$root/build/iso/live-image-amd64.hybrid.iso}"
[[ -n $version && -n $user && -f $built ]] || {
  echo "usage: SOURCEFORGE_USER=NAME iso/publish VERSION [IMAGE]" >&2
  echo "IMAGE defaults to build/iso/live-image-amd64.hybrid.iso; the key to ~/.ssh/hyprtrixie-release" >&2
  exit 1
}
[[ -f $key ]] || {
  echo "no release key at $key (set HYPRTRIXIE_RELEASE_KEY)" >&2
  exit 1
}
out="$(dirname "$built")/$version"
name="hyprtrixie-$version-amd64.iso"
mkdir -p "$out"
ln -f "$built" "$out/$name"
if command -v sha256sum >/dev/null; then
  (cd "$out" && sha256sum "$name" >SHA256SUMS)
else
  (cd "$out" && shasum -a 256 "$name" >SHA256SUMS)
fi
rm -f "$out/SHA256SUMS.sig"
ssh-keygen -Y sign -f "$key" -n file "$out/SHA256SUMS"
rsync -e ssh --progress "$out/$name" "$out/SHA256SUMS" "$out/SHA256SUMS.sig" "$user@frs.sourceforge.net:/home/frs/project/$project/$version/"
echo
echo "Download: https://sourceforge.net/projects/$project/files/$version/$name/download"
echo "SHA-256:  $(cut -d' ' -f1 "$out/SHA256SUMS")"
echo "Check:    sha256sum -c SHA256SUMS && ssh-keygen -Y verify -f manifests/release-signers -I release -n file -s SHA256SUMS.sig <SHA256SUMS"
