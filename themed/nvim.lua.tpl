local function blend(top, bottom, amount)
  if not (top:match("^#%x%x%x%x%x%x$") and bottom:match("^#%x%x%x%x%x%x$")) then
    return bottom
  end
  local mixed = {}
  for _, at in ipairs({ 2, 4, 6 }) do
    local upper, lower = tonumber(top:sub(at, at + 1), 16), tonumber(bottom:sub(at, at + 1), 16)
    table.insert(mixed, math.floor(upper * amount + lower * (1 - amount) + 0.5))
  end
  return string.format("#%02x%02x%02x", mixed[1], mixed[2], mixed[3])
end

