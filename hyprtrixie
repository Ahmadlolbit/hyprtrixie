#!/usr/bin/env bash
set -uo pipefail

HYPRTRIXIE_VERSION="0.1.0"
HYPRTRIXIE_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
LOCK_FILE="${HYPRTRIXIE_LOCK:-/run/hyprtrixie.lock}"
ASSUME_YES=0
ONLY=""
SKIP=""
RUN_MODE=""
RUN_CHANGES=""

for lib in log ui config step user apt files fetch detect service btrfs menu; do
  source "$HYPRTRIXIE_ROOT/lib/$lib.sh"
done
for module in "$HYPRTRIXIE_ROOT"/modules/[0-9][0-9]-*.sh; do
  [[ -f $module ]] && source "$module"
done
unset lib module

usage() {
  cat <<EOF
hyprtrixie $HYPRTRIXIE_VERSION - Debian 13 with Hyprland, set up properly

USAGE
  hyprtrixie                       Open the setup menu
  hyprtrixie install [options]     Run the setup with the saved configuration
                                     --config FILE      use this configuration file
                                     --only 04,05       run only these modules
                                     --skip 10,11       leave these modules out
                                     --yes              ask nothing, use the configuration as is
                                     --on-failure MODE  ask | halt | continue
                                     --changes FILE     show these update notes in the summary
  hyprtrixie verify [--only ...]   Run every check again
  hyprtrixie modules               List the modules and how they last ended
  hyprtrixie config [show|path|edit|reset]
  hyprtrixie collect [--verbose]   Pack the logs, the report and system details for a bug report;
                                     --verbose also writes everything to ~/hyprtrixie-log-<time>.txt
  hyprtrixie verbose [on|off]      Log the desktop in detail from the next login (run it without sudo)
  hyprtrixie guide                 Read the guide in the terminal
  hyprtrixie update                Pull the newest hyprtrixie and run the installer (run it without sudo)
  hyprtrixie changes               Show what the last hyprtrixie update changed
  hyprtrixie doctor                Check the system and offer the safe fixes (run it with sudo)
  hyprtrixie app list              List the apps you can install, by category (* = installed)
  hyprtrixie app install|remove APP
                                   Install or remove one app and tick or untick it in the configuration
  hyprtrixie version
  hyprtrixie help

Configuration: $CONFIG_FILE
Logs:          $LOG_DIR/ and ~/runbook-logs/
EOF
}

die() {
  printf '%s\n' "$*" >&2
  exit 1
}

require_root() {
  ((EUID == 0)) || die "hyprtrixie needs root for this. Run it again with sudo: sudo $0 ${RUN_MODE:-}"
}

take_lock() {
  exec {LOCK_FD}>"$LOCK_FILE" || die "cannot create $LOCK_FILE"
  flock -n "$LOCK_FD" || die "another hyprtrixie run is still going"
}

bootstrap_gum() {
  command -v gum >/dev/null 2>&1 && return 0
  printf 'Getting the setup screens ready (installing gum)...\n'
  apt_env
  if ! { apt-get -qq update && apt-get -qq -y install gum; } >/dev/null 2>&1; then
    printf 'gum could not be installed, using plain screens for now.\n'
  fi
}

module_selected() {
  local id="$1"
  [[ -n $ONLY && ",$ONLY," != *",$id,"* ]] && return 1
  [[ -n $SKIP && ",$SKIP," == *",$id,"* ]] && return 1
  return 0
}

print_summary() {
  local id status width=${UI_WIDTH:-64} lines=()
  ((${#MODULE_STATUS[@]})) || return 0
  ui_rule "Summary"
  for id in "${MODULE_IDS[@]}"; do
    status="${MODULE_STATUS[$id]:-}"
    [[ -n $status ]] || continue
    case "$status" in
      PASS) status="$C_GREEN$status$C_RESET" ;;
      FAIL) status="$C_RED$status$C_RESET" ;;
      *) status="$C_YELLOW$status$C_RESET" ;;
    esac
    printf '  %s  %-*s %s\n' "$id" "$((width - 16))" "${MODULE_TITLES[$id]}" "$status"
  done
  if [[ $RUN_MODE == install || $RUN_MODE == menu ]]; then
    mapfile -t lines < <(run_summary_lines)
    printf '\n'
    ui_box "${lines[@]}"
  fi
  if [[ -n $RUN_CHANGES && -s $RUN_CHANGES ]]; then
    ui_rule "What changed in this update"
    head -n 30 "$RUN_CHANGES" | sed 's/^/  /'
    (($(wc -l <"$RUN_CHANGES") > 30)) && printf '  … the rest: hyprtrixie changes\n'
  fi
  printf '\n  Log: %s\n' "${LOG_FILE:-none}"
  [[ -n $USER_LOG ]] && printf '  Copy: %s\n' "$USER_LOG"
  [[ -n ${TARGET_HOME:-} && -f $TARGET_HOME/runbook-report.md ]] && printf '  Report: %s\n' "$TARGET_HOME/runbook-report.md"
  return 0
}

on_exit() {
  local rc=$?
  ui_spin_stop
  status_save
  if declare -F write_report >/dev/null && [[ -n $TARGET_HOME ]]; then
    write_report >/dev/null 2>&1 || log warn "could not write the report"
  fi
  print_summary
  [[ -n $RUN_PACKAGES ]] && rm -f "$RUN_PACKAGES"
  log info "finished with exit code $rc"
  exit "$rc"
}

on_interrupt() {
  ui_spin_stop
  printf '\n'
  log warn "interrupted"
  exit 130
}

start_run() {
  RUN_MODE="$1"
  shift
  require_root
  take_lock
  bootstrap_gum
  ui_init
  log_init "$RUN_MODE $*" || die "cannot write logs to $LOG_DIR"
  RUN_STARTED=$SECONDS
  RUN_PACKAGES="$(mktemp)" && packages_snapshot >"$RUN_PACKAGES"
  [[ -f $CONFIG_FILE ]] && config_load "$CONFIG_FILE"
  if detect_target_user; then
    log_attach_user "$TARGET_HOME" "$TARGET_USER"
  fi
  trap on_exit EXIT
  trap on_interrupt INT TERM
}

parse_run_options() {
  local value
  while (($#)); do
    case "$1" in
      --config)
        value="${2:-}"
        [[ -f $value ]] || die "no such configuration file: $value"
        RUN_CONFIG="$value"
        shift
        ;;
      --only)
        ONLY="${2:-}"
        shift
        ;;
      --skip)
        SKIP="${2:-}"
        shift
        ;;
      --yes | -y) ASSUME_YES=1 ;;
      --changes)
        RUN_CHANGES="${2:-}"
        shift
        ;;
      --on-failure)
        value="${2:-}"
        [[ $value == ask || $value == halt || $value == continue ]] || die "--on-failure takes ask, halt or continue"
        RUN_FAILURE_MODE="$value"
        shift
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      *) die "unknown option: $1 (see: hyprtrixie help)" ;;
    esac
    shift
  done
}

selected_modules() {
  local id
  for id in "${MODULE_IDS[@]}"; do
    if module_selected "$id"; then
      printf '%s\n' "$id"
    else
      log info "module $id not selected"
    fi
  done
}

run_modules() {
  local id ids=()
  mapfile -t ids < <(selected_modules)
  MODULE_TOTAL=${#ids[@]}
  MODULE_POSITION=0
  for id in "${ids[@]}"; do
    MODULE_POSITION=$((MODULE_POSITION + 1))
    run_module "$id"
  done
}

apply_run_config() {
  if [[ -n ${RUN_CONFIG:-} ]]; then
    config_load "$RUN_CONFIG" || die "cannot read $RUN_CONFIG"
  fi
  return 0
}

apply_run_overrides() {
  [[ -n ${RUN_FAILURE_MODE:-} ]] && FAILURE_MODE="$RUN_FAILURE_MODE"
  return 0
}

show_machine() {
  local lines=()
  detect_all
  mapfile -t lines < <(detect_summary)
  detect_summary | while IFS= read -r line; do log info "$line"; done
  ui_box "${lines[@]}"
}

cmd_install() {
  parse_run_options "$@"
  start_run install "$@"
  apply_run_config
  ui_logo
  ui_header "hyprtrixie $HYPRTRIXIE_VERSION" "Debian 13 with Hyprland, set up properly"
  show_machine
  if ! ((ASSUME_YES)) && ui_can_ask; then
    ui_confirm "Start the setup now?" yes || exit 0
  fi
  config_save
  apply_run_overrides
  run_modules
  ((${#STEP_FAILURES[@]} == 0))
}

cmd_menu() {
  start_run menu
  ui_logo
  ui_header "hyprtrixie $HYPRTRIXIE_VERSION" "Debian 13 with Hyprland, set up properly"
  show_machine
  if ! ui_can_ask; then
    die "the menu needs a terminal; use: sudo $0 install --yes"
  fi
  menu_main || exit 0
  config_save
  run_modules
  ((${#STEP_FAILURES[@]} == 0))
}

cmd_verify() {
  local id ids=()
  parse_run_options "$@"
  start_run verify "$@"
  apply_run_config
  apply_run_overrides
  detect_all
  mapfile -t ids < <(selected_modules)
  MODULE_TOTAL=${#ids[@]}
  MODULE_POSITION=0
  for id in "${ids[@]}"; do
    MODULE_POSITION=$((MODULE_POSITION + 1))
    module_begin "$id"
    verify_module "$id"
    module_finish "$id"
  done
  ((${#STEP_FAILURES[@]} == 0))
}

cmd_modules() {
  local id last status when
  ui_init
  for id in "${MODULE_IDS[@]}"; do
    last="$(status_of "$id")"
    status="${last%%|*}"
    when="${last#*|}"
    printf '%s  %-34s %-8s %s\n' "$id" "${MODULE_TITLES[$id]}" "${status:-never}" "${last:+$when}"
  done
}

cmd_config() {
  case "${1:-show}" in
    show)
      [[ -f $CONFIG_FILE ]] && config_load "$CONFIG_FILE"
      config_show
      ;;
    path) printf '%s\n' "$CONFIG_FILE" ;;
    edit)
      RUN_MODE="config edit"
      require_root
      [[ -f $CONFIG_FILE ]] || config_save
      "${EDITOR:-nano}" "$CONFIG_FILE"
      ;;
    reset)
      RUN_MODE="config reset"
      require_root
      rm -f "$CONFIG_FILE"
      printf 'Configuration reset; defaults apply on the next run.\n'
      ;;
    *) die "usage: hyprtrixie config [show|path|edit|reset]" ;;
  esac
}

collect_files() {
  local dest="$1" file
  cp -r "$LOG_DIR" "$dest/log" 2>/dev/null
  cp -r "$TARGET_HOME/runbook-logs" "$dest/" 2>/dev/null
  for file in "$TARGET_HOME/runbook-report.md" "$CONFIG_FILE" "$STATUS_FILE" /run/user/"$TARGET_UID"/hypr/*/hyprland.log; do
    if [[ -f $file ]]; then
      cp "$file" "$dest/"
    fi
  done
}

collect_system() {
  detect_all
  detect_summary
  printf '\n'
  uname -a
  cat /etc/os-release
  printf '\n'
  lspci -nnk
  lsusb
  printf '\n'
  ip -brief address
  nmcli general status
  findmnt -t btrfs
  printf '\n'
  dpkg-query -W -f '${Package} ${Version}\n' 'hyprland*' quickshell 'linux-image-*' 'firmware-*' 'nvidia-*' mesa-vulkan-drivers
  printf '\n'
  journalctl -b -p warning --no-pager -n 300
}

collect_desktop() {
  local state="$TARGET_HOME/.local/state/omarchy/current"
  cat "$state/theme.name"
  ls -l "$state" "$state/theme"
  printf '\n'
  pgrep -a -u "$TARGET_USER" -x 'Hyprland|hyprpaper|hypridle|mako|elephant|walker|qs|quickshell'
  printf '\n'
  as_user qs log -p "$SHARE_DIR/shell" -t 300
}

verbose_section() {
  printf '\n==== %s\n\n' "$1"
}

hypr_instance() {
  local dirs=()
  mapfile -t dirs < <(ls -td /run/user/"$TARGET_UID"/hypr/*/ 2>/dev/null)
  ((${#dirs[@]})) || return 1
  basename "${dirs[0]}"
}

as_hypr() {
  local instance
  if ! instance="$(hypr_instance)"; then
    printf 'Hyprland is not running\n'
    return 0
  fi
  as_user env HYPRLAND_INSTANCE_SIGNATURE="$instance" "$@"
}

verbose_tail() {
  if [[ -f $2 ]]; then
    tail -n "$1" "$2"
  else
    printf '(no %s)\n' "$2"
  fi
}

last_run_commit() {
  sed -n 's/.*hyprtrixie [^ ]* (\([0-9a-f]*\)) from .*/\1/p' "$LOG_DIR"/run-*.log 2>/dev/null | tail -n 1
}

verbose_summary() {
  local verbose=off
  [[ -f $TARGET_HOME/.config/hyprtrixie/verbose ]] && verbose=on
  verbose_section "Summary"
  printf 'Date          %s\n' "$(date '+%F %T %z')"
  printf 'hyprtrixie    %s from %s\n' "$HYPRTRIXIE_VERSION" "$HYPRTRIXIE_ROOT"
  printf 'Repo          %s\n' "$(git -C "$HYPRTRIXIE_ROOT" log -1 --format='%h %s (%D)' 2>/dev/null || printf 'not a git checkout')"
  printf 'Last install  from %s\n' "$(last_run_commit)"
  printf 'Verbose       %s\n\n' "$verbose"
  detect_all
  detect_summary
  printf '\n'
  dpkg-query -W -f '${Package} ${Version}\n' hyprland quickshell hyprpaper hypridle hyprlock mako-notifier sddm 'linux-image-[0-9]*' 2>/dev/null
  printf 'walker %s\n' "$("$BIN_DIR/walker" --version 2>/dev/null || printf 'not found')"
  printf 'elephant %s\n' "$("$BIN_DIR/elephant" version 2>/dev/null || printf 'not found')"
}

verbose_files() {
  local commit last path hash
  verbose_section "Installed files"
  commit="$(git -C "$HYPRTRIXIE_ROOT" rev-parse --short HEAD 2>/dev/null)"
  last="$(last_run_commit)"
  if [[ -z $last ]]; then
    printf 'The installer has not run from this folder yet\n'
  elif [[ -z $commit ]]; then
    printf 'The installer last ran from %s; this folder is not a git checkout\n' "$last"
  elif [[ $commit == "$last"* || $last == "$commit"* ]]; then
    printf 'The installer last ran from the current commit (%s)\n' "$commit"
  else
    printf 'The repo is at %s but the installer last ran from %s: run sudo ./hyprtrixie install\n' "$commit" "$last"
  fi
  if [[ -f $FILES_DB ]]; then
    while IFS=$'\t' read -r path hash; do
      if [[ ! -e $path ]]; then
        printf 'missing  %s\n' "$path"
      elif [[ $(file_hash "$path") != "$hash" ]]; then
        printf 'edited   %s\n' "$path"
      fi
    done <"$FILES_DB"
  fi
  find /etc /usr/share/hyprtrixie "$TARGET_HOME/.config" -name '*.hyprtrixie-new' 2>/dev/null
  verbose_section "Modules"
  cmd_modules
}

verbose_desktop() {
  local state="$TARGET_HOME/.local/state/omarchy/current" request
  verbose_section "Theme"
  cat "$state/theme.name"
  ls -l "$state"
  verbose_section "Desktop programs"
  pgrep -a -u "$TARGET_USER" -x 'Hyprland|hyprpaper|hypridle|hyprlock|mako|elephant|walker|qs|quickshell'
  for request in version monitors workspaces clients layers configerrors; do
    verbose_section "hyprctl $request"
    as_hypr hyprctl "$request"
  done
  verbose_section "hyprctl hyprpaper listactive"
  as_hypr hyprctl hyprpaper listactive
}

verbose_logs() {
  local file instance bar=()
  verbose_section "Bar log"
  mapfile -t bar < <(ls -t /run/user/"$TARGET_UID"/quickshell/by-id/*/log.qslog 2>/dev/null)
  if ((${#bar[@]})); then
    printf '%s\n' "${bar[0]}"
    as_user env NO_COLOR=1 qs log -t 3000 "${bar[0]}"
  else
    printf '(no bar log)\n'
  fi
  for file in "$TARGET_HOME"/.local/state/hyprtrixie/logs/*.log; do
    [[ -f $file ]] || continue
    verbose_section "Program log ${file##*/}"
    tail -n 400 "$file"
  done
  verbose_section "Session log"
  verbose_tail 400 "$TARGET_HOME/.local/share/sddm/wayland-session.log"
  verbose_section "Hyprland log"
  if instance="$(hypr_instance)"; then
    verbose_tail 600 "/run/user/$TARGET_UID/hypr/$instance/hyprland.log"
  else
    printf 'Hyprland is not running\n'
  fi
  verbose_section "Your journal (this boot)"
  journalctl -b _UID="$TARGET_UID" --no-pager -n 400
  verbose_section "System warnings (this boot)"
  journalctl -b -p warning --no-pager -n 200
  verbose_section "Kernel errors and warnings"
  dmesg --level=err,warn 2>/dev/null | tail -n 100
  verbose_section "Last install run"
  verbose_tail 80 "$LOG_DIR/latest.log"
}

collect_verbose() {
  verbose_summary
  verbose_files
  verbose_desktop
  verbose_logs
}

cmd_collect() {
  local name work out stamp logfile="" verbose=0
  case "${1:-}" in
    "") ;;
    --verbose) verbose=1 ;;
    *) die "usage: hyprtrixie collect [--verbose]" ;;
  esac
  RUN_MODE=collect
  require_root
  detect_target_user || die "cannot tell whose desktop this is; run it with sudo from your own account"
  stamp="$(date +%Y%m%d-%H%M%S)"
  name="hyprtrixie-collect-$stamp"
  work="$(mktemp -d)" || die "cannot create a temporary folder"
  mkdir -p "$work/$name"
  collect_files "$work/$name"
  collect_system >"$work/$name/system.txt" 2>&1
  collect_desktop >"$work/$name/desktop.txt" 2>&1
  if ((verbose)); then
    logfile="$TARGET_HOME/hyprtrixie-log-$stamp.txt"
    collect_verbose >"$logfile" 2>&1
    chown "$TARGET_USER:" "$logfile"
    cp "$logfile" "$work/$name/"
  fi
  out="$TARGET_HOME/$name.tar.gz"
  tar -czf "$out" -C "$work" "$name" || die "cannot write $out"
  chown "$TARGET_USER:" "$out"
  rm -rf "$work"
  printf 'Saved %s\n' "$out"
  if [[ -n $logfile ]]; then
    printf 'Log: %s\n' "$logfile"
  fi
}

cmd_verbose() {
  local flag="${XDG_CONFIG_HOME:-$HOME/.config}/hyprtrixie/verbose"
  ((EUID != 0)) || die "run it as yourself, without sudo: hyprtrixie verbose ${1:-status}"
  case "${1:-status}" in
    on)
      if ! mkdir -p "${flag%/*}" || ! touch "$flag"; then
        die "cannot write $flag"
      fi
      printf 'Verbose logging is on from the next login: log out and back in.\n'
      ;;
    off)
      rm -f "$flag"
      printf 'Verbose logging is off from the next login.\n'
      ;;
    status)
      if [[ -f $flag ]]; then
        printf 'on\n'
      else
        printf 'off\n'
      fi
      ;;
    *) die "usage: hyprtrixie verbose [on|off|status]" ;;
  esac
}

guide_title() {
  local line
  line="$(grep -m1 '^# ' "$1")"
  if [[ -n $line ]]; then
    printf '%s' "${line#\# }"
  else
    basename "$1" .md
  fi
}

cmd_guide() {
  local dir="$HYPRTRIXIE_ROOT/docs/guide" pages=() titles=() page choice i
  mapfile -t pages < <(find "$dir" -maxdepth 1 -name '*.md' 2>/dev/null | sort)
  if ((${#pages[@]} == 0)); then
    printf 'The guide has no pages yet. They go in %s, one Markdown file per topic.\n' "$dir"
    return 0
  fi
  if ! command -v gum >/dev/null 2>&1 || [[ ! -t 1 ]]; then
    cat "${pages[@]}"
    return 0
  fi
  for page in "${pages[@]}"; do
    titles+=("$(guide_title "$page")")
  done
  while :; do
    choice="$(gum choose --header "Guide · pick a topic, Esc to leave" --cursor "> " "${titles[@]}")" || return 0
    for i in "${!titles[@]}"; do
      [[ ${titles[$i]} == "$choice" ]] && gum format <"${pages[$i]}" | gum pager
    done
  done
}

changes_dir() {
  printf '%s/hyprtrixie' "${XDG_STATE_HOME:-$HOME/.local/state}"
}

changes_between() {
  local old="$1" new="$2" commit first second subject title number others
  git -C "$HYPRTRIXIE_ROOT" log --first-parent --merges --format='%H %P' "$old..$new" |
    while read -r commit first second; do
      subject="$(git -C "$HYPRTRIXIE_ROOT" log -1 --format=%s "$commit")"
      title="$(git -C "$HYPRTRIXIE_ROOT" log -1 --format=%b "$commit" | sed -n '/./{p;q}')"
      number="$(sed -n 's/^Merge pull request #\([0-9]*\) .*/\1/p' <<<"$subject")"
      printf '%s\n' "${number:+#$number }${title:-$subject}"
      git -C "$HYPRTRIXIE_ROOT" log --no-merges --format='  - %s' "$first..$second"
    done
  others="$(git -C "$HYPRTRIXIE_ROOT" log --first-parent --no-merges --format='  - %s' "$old..$new")"
  [[ -n $others ]] && printf 'Other changes\n%s\n' "$others"
  return 0
}

cmd_update() {
  local old new dir
  ((EUID != 0)) || die "run it as yourself, without sudo: hyprtrixie update"
  git -C "$HYPRTRIXIE_ROOT" rev-parse --git-dir >/dev/null 2>&1 ||
    die "$HYPRTRIXIE_ROOT is not a git clone, so it can't update itself"
  old="$(git -C "$HYPRTRIXIE_ROOT" rev-parse HEAD)"
  printf 'Updating %s\n' "$HYPRTRIXIE_ROOT"
  git -C "$HYPRTRIXIE_ROOT" pull --ff-only ||
    die "git pull failed: the folder has local changes, or its branch has no upstream"
  new="$(git -C "$HYPRTRIXIE_ROOT" rev-parse HEAD)"
  if [[ $old == "$new" ]]; then
    printf 'hyprtrixie is already up to date.\n'
    return 0
  fi
  dir="$(changes_dir)"
  mkdir -p "$dir" && changes_between "$old" "$new" >"$dir/changes.txt" && touch "$dir/changes-unseen"
  printf '\nWhat changed:\n'
  cat "$dir/changes.txt"
  printf '\n'
  exec sudo "$HYPRTRIXIE_ROOT/hyprtrixie" install --changes "$dir/changes.txt"
}

changes_notify() {
  local dir="$1" count action
  [[ -f $dir/changes-unseen && -s $dir/changes.txt ]] || return 0
  rm -f "$dir/changes-unseen"
  count="$(grep -c '^  - ' "$dir/changes.txt")"
  action="$(notify-send --app-name=hyprtrixie --action=default=Read "hyprtrixie was updated" \
    "$count changes since the last update. Click to read them, or open Menu › Update › What changed.")"
  [[ $action == default ]] && exec hyprtrixie-terminal --wait "$HYPRTRIXIE_ROOT/hyprtrixie" changes
  return 0
}

cmd_changes() {
  local dir
  dir="$(changes_dir)"
  if [[ ${1:-} == --notify ]]; then
    changes_notify "$dir"
    return
  fi
  if [[ -s $dir/changes.txt ]]; then
    cat "$dir/changes.txt"
  else
    printf 'No update notes yet. hyprtrixie update writes them.\n'
  fi
  rm -f "$dir/changes-unseen"
}

POWER_SUPPLY_DIR="${HYPRTRIXIE_POWER_SUPPLY:-/sys/class/power_supply}"
DOCTOR_QUESTIONS=()
DOCTOR_COMMANDS=()

doctor_offer() {
  local question="$1"
  shift
  DOCTOR_QUESTIONS+=("$question")
  DOCTOR_COMMANDS+=("$(printf '%q ' "$@")")
}

doctor_restart() {
  as_hypr hyprctl dispatch "hl.dsp.exec_cmd([[hyprtrixie-start $1]])"
}

doctor_check_desktop() {
  local spec name missing=()
  if ! pgrep -u "$TARGET_UID" -x Hyprland >/dev/null; then
    ui_status skip "Desktop programs: Hyprland isn't running for $TARGET_USER"
    return 0
  fi
  for spec in "bar|qs -p /usr/share/hyprtrixie/shell" "hyprpaper|^hyprpaper" "mako|^mako" "elephant|^elephant" \
    "walker|walker --gapplication-service" "hypridle|^hypridle"; do
    name="${spec%%|*}"
    pgrep -u "$TARGET_UID" -f "${spec#*|}" >/dev/null || missing+=("$name")
  done
  if ((${#missing[@]} == 0)); then
    ui_status ok "The bar, wallpaper, notifications, launcher and idle timer are running"
    return 0
  fi
  ui_status fail "Not running: ${missing[*]}"
  ui_note "Fix: log out and back in, or let the doctor start them again"
  for name in "${missing[@]}"; do
    doctor_offer "Start $name again" doctor_restart "$name"
  done
}

doctor_check_services() {
  local units=() unit
  mapfile -t units < <(systemctl --failed --no-legend --plain 2>/dev/null | awk '{ print $1 }')
  mapfile -t -O "${#units[@]}" units < <(as_user env XDG_RUNTIME_DIR="/run/user/$TARGET_UID" \
    systemctl --user --failed --no-legend --plain 2>/dev/null | awk '{ print "user:" $1 }')
  if ((${#units[@]} == 0)); then
    ui_status ok "No service has failed"
    return 0
  fi
  ui_status fail "Failed services: ${units[*]}"
  ui_note "Fix: systemctl status NAME says why; restarting often helps"
  for unit in "${units[@]}"; do
    if [[ $unit == user:* ]]; then
      doctor_offer "Restart ${unit#user:}" as_user env XDG_RUNTIME_DIR="/run/user/$TARGET_UID" systemctl --user restart "${unit#user:}"
    else
      doctor_offer "Restart $unit" systemctl restart "$unit"
    fi
  done
}

doctor_check_snapshots() {
  local last age
  if [[ $SNAPSHOTS != yes ]]; then
    ui_status skip "Snapshots are turned off"
    return 0
  fi
  if ! service_active snapper-timeline.timer || ! service_active snapper-cleanup.timer; then
    ui_status fail "The snapshot timers aren't running"
    ui_note "Fix: systemctl enable --now snapper-timeline.timer snapper-cleanup.timer"
    doctor_offer "Turn the snapshot timers back on" systemctl enable --now snapper-timeline.timer snapper-cleanup.timer
    return 0
  fi
  last="$(snapper --csvout --no-headers -c root list --columns date 2>/dev/null | tail -n 1)"
  if ! last="$(date -d "$last" +%s 2>/dev/null)"; then
    ui_status warn "No snapshot of the system yet"
    return 0
  fi
  age=$((($(date +%s) - last) / 86400))
  if ((age > 2)); then
    ui_status warn "The newest snapshot is $age days old"
    ui_note "Fix: journalctl -u snapper-timeline says why snapshots stopped"
  else
    ui_status ok "Snapshots are being taken"
  fi
}

doctor_free_space() {
  apt-get clean
  command -v snapper >/dev/null 2>&1 && snapper -c root cleanup number
  journalctl --vacuum-time=2weeks
}

doctor_check_disk() {
  local mount use offered=0
  while read -r mount use; do
    use="${use%\%}"
    if ((use >= 85)); then
      ui_status "$( ((use >= 95)) && printf fail || printf warn)" "$mount is $use% full"
      ui_note "Fix: clear the package cache, trim old snapshots and old logs"
      ((offered++)) || doctor_offer "Free space: clear the package cache, trim old snapshots and old logs" doctor_free_space
    else
      ui_status ok "$mount is $use% full"
    fi
  done < <(df -P / /home 2>/dev/null | awk 'NR > 1 && !seen[$1]++ { print $6, $5 }')
}

doctor_check_battery() {
  local battery full design health found=0
  for battery in "$POWER_SUPPLY_DIR"/BAT*; do
    [[ -d $battery ]] || continue
    full="$(cat "$battery/energy_full" 2>/dev/null || cat "$battery/charge_full" 2>/dev/null)"
    design="$(cat "$battery/energy_full_design" 2>/dev/null || cat "$battery/charge_full_design" 2>/dev/null)"
    [[ $full =~ ^[0-9]+$ && $design =~ ^[1-9][0-9]*$ ]] || continue
    found=1
    health=$((full * 100 / design))
    if ((health < 70)); then
      ui_status warn "Battery ${battery##*/} holds $health% of what it did when new"
      ui_note "Fix: none needed yet; a replacement brings the runtime back"
    else
      ui_status ok "Battery ${battery##*/} holds $health% of what it did when new"
    fi
  done
  ((found)) || ui_status skip "No battery found"
  return 0
}

doctor_check_firmware() {
  local errors=() firmware=()
  mapfile -t errors < <(journalctl -k -b -p 3 --no-pager -q -o cat 2>/dev/null | sort -u)
  mapfile -t firmware < <(printf '%s\n' "${errors[@]}" | grep -i firmware)
  if ((${#firmware[@]})); then
    ui_status warn "Firmware or driver errors since boot: ${#firmware[@]}"
    printf '%s\n' "${firmware[@]:0:3}" | while IFS= read -r line; do ui_note "$line"; done
    ui_note "Fix: sudo hyprtrixie collect --verbose and send the file it prints"
  else
    ui_status ok "No firmware errors since boot (${#errors[@]} other kernel errors)"
  fi
}

doctor_check_updates() {
  local count
  count="$(apt list --upgradable 2>/dev/null | grep -c upgradable)"
  if ((count)); then
    ui_status warn "$count package updates are waiting"
    ui_note "Fix: Menu › Update › Debian packages, or sudo apt full-upgrade"
  else
    ui_status ok "Packages are up to date"
  fi
}

doctor_check_files() {
  local path hash missing=() edited=() fresh=()
  if [[ -f $FILES_DB ]]; then
    while IFS=$'\t' read -r path hash; do
      if [[ ! -e $path ]]; then
        missing+=("$path")
      elif [[ $(file_hash "$path") != "$hash" ]]; then
        edited+=("$path")
      fi
    done <"$FILES_DB"
  fi
  mapfile -t fresh < <(find /etc /usr/share/hyprtrixie "$TARGET_HOME/.config" -name '*.hyprtrixie-new' 2>/dev/null)
  if ((${#missing[@]})); then
    ui_status fail "Installed files are missing: ${missing[*]:0:3}"
    ui_note "Fix: sudo hyprtrixie install puts them back"
  else
    ui_status ok "Every installed file is in place (${#edited[@]} edited by you)"
  fi
  if ((${#fresh[@]})); then
    ui_status warn "Newer versions wait next to files you edited: ${fresh[*]:0:3}"
    ui_note "Fix: compare each with its .hyprtrixie-new copy and keep what you want"
  fi
}

doctor_check_installer() {
  local commit last
  commit="$(git -C "$HYPRTRIXIE_ROOT" rev-parse --short HEAD 2>/dev/null)"
  last="$(last_run_commit)"
  if [[ -z $last || -z $commit ]]; then
    ui_status skip "Can't tell which version the installer last ran from"
  elif [[ $commit == "$last"* || $last == "$commit"* ]]; then
    ui_status ok "The installer last ran from this folder's version ($commit)"
  else
    ui_status warn "This folder is at $commit but the installer last ran from $last"
    ui_note "Fix: sudo hyprtrixie install"
  fi
}

doctor_fixes() {
  local i
  if ((${#DOCTOR_QUESTIONS[@]} == 0)); then
    printf '\nNothing for the doctor to fix.\n'
    return 0
  fi
  if ! ui_can_ask; then
    printf '\nRun it in a terminal to apply the fixes it offers.\n'
    return 0
  fi
  printf '\n'
  for i in "${!DOCTOR_QUESTIONS[@]}"; do
    ui_confirm "${DOCTOR_QUESTIONS[$i]}?" no || continue
    if eval "${DOCTOR_COMMANDS[$i]}"; then
      ui_status ok "${DOCTOR_QUESTIONS[$i]}"
    else
      ui_status fail "${DOCTOR_QUESTIONS[$i]}"
    fi
  done
}

cmd_doctor() {
  require_root
  ui_init
  detect_target_user || die "cannot tell whose desktop this is; run it with sudo from your own account"
  [[ -f $CONFIG_FILE ]] && config_load "$CONFIG_FILE"
  ui_header "hyprtrixie doctor" "Checks the system and offers the safe fixes"
  ui_rule "Desktop"
  doctor_check_desktop
  doctor_check_services
  ui_rule "Storage"
  doctor_check_snapshots
  doctor_check_disk
  ui_rule "Hardware and packages"
  doctor_check_battery
  doctor_check_firmware
  doctor_check_updates
  ui_rule "hyprtrixie"
  doctor_check_files
  doctor_check_installer
  doctor_fixes
}

app_untick() {
  local id="$1" item rest=()
  for item in $APPS; do
    [[ $item == "$id" ]] || rest+=("$item")
  done
  APPS="${rest[*]}"
}

cmd_app() {
  local action="${1:-list}" id="${2:-}"
  case "$action" in
    list)
      [[ -f $CONFIG_FILE ]] && config_load "$CONFIG_FILE"
      apps_list "$id"
      ;;
    install | remove)
      [[ -n $id ]] || die "usage: sudo hyprtrixie app $action APP (see: hyprtrixie app list)"
      manifest_line apps "$id" >/dev/null || die "no app named $id (see: hyprtrixie app list)"
      start_run "app-$action" "$id"
      if [[ $action == install ]]; then
        app_wanted "$id" || APPS="${APPS:+$APPS }$id"
        config_save
        run_step "Install $(app_name "$id")" app_install "$id"
        run_step "Choose the apps that open images, PDFs, videos and archives" default_apps_set
      else
        app_untick "$id"
        config_save
        run_step "Remove $(app_name "$id")" app_remove "$id"
      fi
      ((${#STEP_FAILURES[@]} == 0))
      ;;
    *) die "usage: hyprtrixie app [list [installed|available] | install APP | remove APP]" ;;
  esac
}

main() {
  case "${1:-}" in
    "") cmd_menu ;;
    install)
      shift
      cmd_install "$@"
      ;;
    verify)
      shift
      cmd_verify "$@"
      ;;
    modules) cmd_modules ;;
    collect)
      shift
      cmd_collect "$@"
      ;;
    verbose)
      shift
      cmd_verbose "$@"
      ;;
    app)
      shift
      cmd_app "$@"
      ;;
    guide) cmd_guide ;;
    doctor) cmd_doctor ;;
    update) cmd_update ;;
    changes)
      shift
      cmd_changes "$@"
      ;;
    config)
      shift
      cmd_config "$@"
      ;;
    version | --version) printf 'hyprtrixie %s\n' "$HYPRTRIXIE_VERSION" ;;
    help | -h | --help) usage ;;
    *) die "unknown command: $1 (see: hyprtrixie help)" ;;
  esac
}

main "$@"
