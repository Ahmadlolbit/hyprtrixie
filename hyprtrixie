#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
tools="${HYPRTRIXIE_TOOLS_DIR:-$root/build/bin}"
core="${HYPRTRIXIE_CORE:-/usr/local/bin/hyprtrixie-core}"
export HYPRTRIXIE_ROOT="$root"
if [[ ! -O $root ]]; then
  count="${GIT_CONFIG_COUNT:-0}"
  export "GIT_CONFIG_KEY_$count=safe.directory" "GIT_CONFIG_VALUE_$count=$root" GIT_CONFIG_COUNT=$((count + 1))
fi

as_root() {
  if ((EUID == 0)); then
    "$@"
    return
  fi
  if ! command -v sudo >/dev/null || ! sudo -v; then
    printf 'This needs root, and this account cannot use sudo yet. Log in as root and run: %s\n' "$0" >&2
    exit 1
  fi
  sudo "$@"
}

needs_root() {
  ((EUID == 0)) && return 0
  printf 'Hyprtrixie needs root for this. Run it again with sudo: sudo %s %s\n' "$0" "$1" >&2
  exit 1
}

stale() {
  [[ ! -x $tools/hyprtrixie-core ]] && return 0
  [[ -n $(find "$root/cmd" "$root/internal" "$root/vendor" "$root/go.mod" -newer "$tools/hyprtrixie-core" -print -quit) ]]
}

build() {
  ((${HYPRTRIXIE_TOOLS_BUILT:-0})) && return 0
  stale || return 0
  if ! command -v go >/dev/null; then
    as_root apt-get update
    as_root apt-get install -y golang-go
  fi
  local builder=()
  if [[ -e $root/build && ! -w $root/build && -O $root ]]; then
    as_root chown -R "$(id -u):$(id -g)" "$root/build"
  elif [[ -e $root/build && ! -w $root/build ]]; then
    builder=(as_root)
  fi
  printf 'Building the Hyprtrixie tools\n' >&2
  (cd "$root" && "${builder[@]}" env CGO_ENABLED=0 go build -buildvcs=false -trimpath -ldflags='-s -w' -o "$tools/" ./cmd/...)
  local tool
  for tool in "$root"/cmd/hyprtrixie-core/tools/*/; do
    tool="${tool%/}"
    "${builder[@]}" ln -sfn hyprtrixie-core "$tools/${tool##*/}"
  done
}

fresh() {
  HYPRTRIXIE_ENGINE=1 exec -a "$0" "$tools/hyprtrixie-core" "$@"
}

if [[ -n ${HYPRTRIXIE_FROM_CORE:-} ]]; then
  unset HYPRTRIXIE_FROM_CORE
  build
  fresh "$@"
fi

case "${1:-} ${2:-}" in
  " ")
    if ((EUID == 0)) && [[ -n ${SUDO_USER:-} ]]; then
      printf 'run it as yourself, without sudo: %s\n' "$0" >&2
      exit 1
    fi
    build
    unset HYPRTRIXIE_ENGINE
    exec "$tools/hyprtrixie"
    ;;
  install\ *)
    needs_root install
    build
    fresh "$@"
    ;;
  "app install" | "app remove")
    needs_root "app $2${3:+ $3}"
    build
    fresh "$@"
    ;;
  verify\ *)
    needs_root verify
    if command -v go >/dev/null; then
      build
      fresh "$@"
    fi
    ;;
esac

if [[ -f $core && -x $core && -s $core ]]; then
  HYPRTRIXIE_ENGINE=1 exec -a "$0" "$core" "$@"
fi
build
fresh "$@"
