Window.SetBackgroundTopColor({{ BACKGROUND }});
Window.SetBackgroundBottomColor({{ BACKGROUND }});

step = 1;
prompt_font = "Sans 13";
bullet_font = "Sans 18";
message_font = "Sans 12";
logo = Image("burst-4.png");
if (Window.GetWidth() >= 2560 || Window.GetHeight() >= 1440) {
  step = 2;
  prompt_font = "Sans 26";
  bullet_font = "Sans 36";
  message_font = "Sans 24";
  logo = Image("burst-8.png");
}
logo_sprite = Sprite(logo);
logo_sprite.SetPosition(Window.GetWidth() / 2 - logo.GetWidth() / 2, Window.GetHeight() / 2 - logo.GetHeight(), 1);
below = Window.GetHeight() / 2;

custom = "{{ BOOT_PROMPT }}";
prompt_sprite = Sprite();
bullet_sprite = Sprite();
message_sprite = Sprite();

fun centre(sprite, image, y) {
  sprite.SetImage(image);
  sprite.SetPosition(Window.GetWidth() / 2 - image.GetWidth() / 2, y, 2);
  sprite.SetOpacity(1);
}

fun asks_pin(text) {
  for (i = 0; i < 200; i++)
    if (text.SubString(i, i + 3) == "PIN")
      return 1;
  return 0;
}

fun display_password(prompt, bullets) {
  dots = "";
  for (i = 0; i < bullets; i++)
    dots = dots + "• ";
  if (custom != "" && !asks_pin(prompt))
    prompt = custom;
  if (prompt == "")
    prompt = "Password";
  centre(prompt_sprite, Image.Text(prompt, {{ FOREGROUND }}, 1, prompt_font), below + 60 * step);
  centre(bullet_sprite, Image.Text(dots + "_", {{ ACCENT }}, 1, bullet_font), below + 100 * step);
}

fun display_normal() {
  prompt_sprite.SetOpacity(0);
  bullet_sprite.SetOpacity(0);
}

fun display_message(text) {
  centre(message_sprite, Image.Text(text, {{ FOREGROUND }}, 1, message_font), Window.GetHeight() - 80 * step);
}

Plymouth.SetDisplayPasswordFunction(display_password);
Plymouth.SetDisplayNormalFunction(display_normal);
Plymouth.SetMessageFunction(display_message);
